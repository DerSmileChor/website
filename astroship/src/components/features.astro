---
// @ts-ignore
import { Icon } from "astro-icon/components";

interface Feature {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  intro: {
    headingBeforeAccent: string;
    headingAccent: string;
    headingAfterAccent: string;
    description: string;
  };
  features: Feature[];
}

const { intro, features } = Astro.props;
---

<main  var(--accent-home);">
  <section class="mt-12 md:mt-0">
    <div class="max-w-3xl">
      <h2
        class="
          text-4xl font-bold leading-[1.05] tracking-tight
          lg:text-5xl lg:tracking-tight
        "
      >
        {intro.headingBeforeAccent}{" "}
        <span class="accent-text">{intro.headingAccent}</span>{" "}
        {intro.headingAfterAccent}
      </h2>

      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        {intro.description}
      </p>
    </div>

    <div
      class="
        mt-12 grid grid-cols-1 gap-8
        sm:grid-cols-2
        md:mt-16 md:grid-cols-3 md:gap-16
      "
    >
      {
        features.map((item) => (
          <article
            class="
              grid grid-cols-[40px_minmax(0,1fr)] items-start gap-4
              sm:flex sm:gap-4
            "
          >
            <div
              class="
                flex h-10 w-10 shrink-0 items-center justify-center
                rounded-full accent-bg
                sm:mt-1 sm:h-8 sm:w-8
              "
            >
              <Icon
                class="h-5 w-5 text-white sm:h-auto sm:w-auto"
                name={item.icon}
              />
            </div>

            <div class="min-w-0">
              <h3
                class="
                  text-xl font-semibold leading-tight text-slate-900
                  sm:text-lg
                "
              >
                {item.title}
              </h3>

              <p class="mt-2 text-base leading-relaxed text-slate-500">
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</main>