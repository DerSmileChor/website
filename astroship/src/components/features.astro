---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Volunteer-based",
    description:
      "All our singers volunteer their time and energy to create free, live music for others to enjoy.",
    icon: "bx:bxs-heart",
  },
  {
    title: "All experience levels welcome",
    description:
      "No musical background is necessary to join, just a love of singing and the aspiration to give our audiences a heart-felt performance",
    icon: "bx:bxs-group",
  },
  {
    title: "English-language songs",
    description:
      "Our set list consists primarily of English-language songs to encourage participation by non-German speakers.",
    icon: "bx:bxs-microphone",
  },
  {
    title: "Community outreach",
    description:
      "Our performances take place in community-based organizations, with the aim of bringing live music to those who may have difficulty accessing it.",
    icon: "bx:bxs-donate-heart",
  },
  {
    title: "Supportive environment",
    description:
      "Der Smile Chor fosters a welcoming and relaxed environment for both singers and audiences.",
    icon: "bx:bxs-smile",
  },
  {
    title: "Two seasons a year",
    description:
      "Each summer and winter season consists of around 10 weeks of rehearsal and 5–8 performances.",
    icon: "bx:bxs-calendar",
  },
];
---
<main style="--page-accent: var(--accent-home);">
<section class="mt-12 md:mt-0">
  <div class="max-w-3xl">
    <h2
      class="
        text-4xl font-bold leading-[1.05] tracking-tight
        lg:text-5xl lg:tracking-tight
      "
    >
      Building <span class = "accent-text">community</span> through music
    </h2>

    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      Der Smile Chor aims to build community among our singers as well as
      across the city of Munich.
    </p>
  </div>

  <div
    class="
      mt-12 grid grid-cols-1 gap-8
      sm:grid-cols-2
      md:mt-16 md:grid-cols-3 md:gap-16
    "
  >
    {
      features.map((item) => (
        <article
          class="
            grid grid-cols-[40px_minmax(0,1fr)] items-start gap-4
            sm:flex sm:gap-4
          "
        >
          <div
            class="
              flex h-10 w-10 shrink-0 items-center justify-center
              rounded-full bg-indigo-600
              sm:mt-1 sm:h-8 sm:w-8
            "
          >
            <Icon
              class="h-5 w-5 text-white sm:h-auto sm:w-auto"
              name={item.icon}
            />
          </div>

          <div class="min-w-0">
            <h3
              class="
                text-xl font-semibold leading-tight text-slate-900
                sm:text-lg
              "
            >
              {item.title}
            </h3>

            <p class="mt-2 text-base leading-relaxed text-slate-500">
              {item.description}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
</main>