---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Volunteer-based",
    description:
      "All our singers volunteer their time and energy to create free, live music for others to enjoy",
    icon: "bx:bxs-heart",
  },
  {
    title: "All experience levels welcome",
    description:
      "No musical background is necessary to join, just a love of singing.",
    icon: "bx:bxs-group",
  },
  {
    title: "English-language songs",
    description:
      "Our set list consists primarily of English-language songs promote participation of non-German speakers",
    icon: "bx:bxs-microphone",
  },
  {
    title: "Community Outreach",
    description:
      "Our performances take place in community-based organizations --- with the aim of bringing live music to those who may have difficulty accessing it",
    icon: "bx:bxs-donate-heart",
  },
  {
    title: "Supportive Environment",
    description:
      "Der Smile Chor fosters a welcoming and relaxed environment for both the singers and the audience",
    icon: "bx:bxs-smile",
  },
  {
    title: "Two seasons a year",
    description:
      "Each season (summer and winter) consists of around 10 weeks of rehearsal and 5-8 performances",
    icon: "bx:bxs-calendar",
  },
];
---

<div class="mt-16 md:mt-0">
  <h3 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Building community through music
  </h3>
  <p class="text-lg mt-4 text-slate-600">
    Der Smile Chor aims to build community among our singers as well as across the city of Munich.  
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-indigo-600 rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
