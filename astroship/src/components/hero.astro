---
import { Picture } from "astro:assets";
import heroImage from "assets/logo1.png";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Astronaut in the air"
      widths={[240, 600, 1000]}
      sizes="(max-width: 1000px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Der Smile Chor
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Der Smile Chor is an amateur English-language choir driven by the conviction that music can open hearts and bring people together. Through popular songs which everyone can hum or sing along to, we aim to put a smile on people's faces precisely where it is needed most: care homes for the elderly, refugee shelters, and hospitals.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">

    </div>
  </div>
</main>
