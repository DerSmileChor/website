---
import { Picture } from "astro:assets";
import heroImage from "assets/logo1_transparent.png";
import SmileVideoFlip from "@components/SmileVideoFlip.astro";

interface Props {
  hero: {
    heading: string;
    description: string;
    videoId: string;
    videoTitle: string;
  };
}

const { hero } = Astro.props;
---

<main
  class="grid place-items-center gap-10 px-6 pb-20 pt-10
         md:px-8 md:pb-24 md:pt-12
         lg:grid-cols-2"
 var(--accent-home);"
>
  <!-- Desktop image -->
  <div class="hidden w-full md:order-1 md:block md:py-6">
  <SmileVideoFlip
  videoId={hero.videoId}
  videoTitle={hero.videoTitle}
>
      <Picture
        slot="logo"
        src={heroImage}
        alt="Der Smile Chor logo"
        widths={[240, 600, 1000]}
        sizes="(max-width: 1000px) 100vw, 620px"
        loading="eager"
        format="avif"
        class="h-auto w-full"
      />
    </SmileVideoFlip>
  </div>

  <!-- Hero text -->
  <div class="w-full max-w-3xl">
    <!-- Mobile-only label -->
    <p
      class="mb-4 text-sm font-semibold uppercase tracking-[0.18em]
             accent-text md:hidden"
    >
      Community through music
    </p>

    <h1
      class="text-5xl font-bold leading-[0.95] tracking-tight accent-text
             sm:text-6xl
             lg:text-6xl lg:tracking-tight
             xl:text-7xl xl:tracking-tighter"
    >
      {hero.heading}
    </h1>

    <!-- Mobile-only accent -->
    <div
      class="mt-5 h-1 w-20 rounded-full accent-background md:hidden"
      aria-hidden="true"
    ></div>

    <p
      class="mt-7 max-w-xl text-xl leading-[1.65] text-slate-600
             sm:text-2xl
             md:mt-4 md:text-lg md:leading-relaxed"
    >
       {hero.description}
    </p>

    <!-- Mobile-only buttons -->
    <div class="mt-8 flex flex-wrap gap-3 md:hidden">
      <a
        href="/join"
        class="inline-flex items-center justify-center rounded-full
               accent-background px-6 py-3 font-semibold text-white
               transition hover:accent-background"
      >
        Sing with us
      </a>

      <a
        href="/about"
        class="inline-flex items-center justify-center rounded-full
               border border-slate-300 px-6 py-3 font-semibold
               text-slate-700 transition
               hover:accent-border hover:accent-text"
      >
        Learn more
      </a>
    </div>
  </div>
</main>