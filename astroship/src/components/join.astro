---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
---

<div class="h-full">
  <div
    class="
      flex h-full w-full flex-col
      rounded-md border-2 border-[#D8DEE9] border-opacity-50
      px-6 py-6
    "
  >
    <!-- Card heading -->
    <div class="text-center">
      <h4 class="text-lg font-medium text-gray-400">
        {plan.name}
      </h4>

      <p class="mt-3 text-4xl font-bold text-black">
        {
          plan.join && typeof plan.join === "object"
            ? plan.join.monthly
            : plan.join
        }
      </p>
    </div>

    <!-- What we're looking for -->
    {
      plan.lookingFor?.length > 0 && (
        <section class="mt-8">
          <h5 class="text-lg font-semibold text-gray-900">
            What we’re looking for
          </h5>

          <ul class="mt-4 grid gap-y-3 text-left">
            {plan.lookingFor.map((item) => (
              <li class="flex items-start gap-3 text-gray-700">
                <Icon
                  name="bx:bxs-music"
                  class="mt-0.5 h-5 w-5 shrink-0 text-black"
                />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Expectations -->
    {
      plan.expectations?.length > 0 && (
        <section class="mt-8 border-t border-gray-200 pt-6">
          <h5 class="text-lg font-semibold text-gray-900">
            What to expect
          </h5>

          <ul class="mt-4 grid gap-y-3 text-left">
            {plan.expectations.map((item) => (
              <li class="flex items-start gap-3 text-gray-700">
                <Icon
                  name="bx:music"
                  class="mt-0.5 h-5 w-5 shrink-0 text-black"
                />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }


    <!-- Button -->
    <div class="mt-auto flex pt-8">
      <Link
        href={plan.button.link || "#"}
        block
        style={plan.popular ? "primary" : "outline"}
      >
        {plan.button.text || "Contact Us"}
      </Link>
    </div>
  </div>
</div>