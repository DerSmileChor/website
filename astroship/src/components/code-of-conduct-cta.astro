---
import { Icon } from "astro-icon/components";

interface Props {
  heading: string;
  description: string;
  buttonText: string;
  href: string;
}

const {
  heading,
  description,
  buttonText,
  href,
} = Astro.props;
---

<main">
  <section
    class="
      mx-auto mt-20 flex max-w-5xl flex-col
      items-center rounded-lg accent-background
      p-8 text-center md:px-20 md:py-16
    "
  >
    <Icon
      name="bx:bxs-file-pdf"
      class="h-10 w-10 text-white"
      aria-hidden="true"
    />

    <h2 class="mt-4 text-3xl tracking-tight text-white md:text-5xl">
      {heading}
    </h2>

    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">
      {description}
    </p>

    <div class="mt-7">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="
          inline-flex rounded-md bg-white
          px-6 py-3 font-semibold text-black
          transition hover:bg-slate-200
        "
      >
        {buttonText}
      </a>
    </div>
  </section>
</main>