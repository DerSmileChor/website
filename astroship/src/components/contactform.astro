---
import Button from "./ui/button.astro";

interface Props {
  content: {
    namePlaceholder: string;
    nameRequiredMessage: string;
    emailPlaceholder: string;
    emailRequiredMessage: string;
    emailInvalidMessage: string;
    messagePlaceholder: string;
    messageRequiredMessage: string;
    buttonText: string;
  };
}

const { content } = Astro.props;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation flex h-full flex-col"
  novalidate
>
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />

  <input
    type="checkbox"
    class="hidden"
    style="display:none"
    name="botcheck"
  />

  <div class="mb-5">
    <input
      type="text"
      placeholder={content.namePlaceholder}
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="name"
    />

    <div class="empty-feedback hidden invalid-feedback text-red-400 text-sm mt-1">
      {content.nameRequiredMessage}
    </div>
  </div>

  <div class="mb-5">
    <label for="email_address" class="sr-only">
      Email Address
    </label>

    <input
      id="email_address"
      type="email"
      placeholder={content.emailPlaceholder}
      name="email"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
    />

    <div class="empty-feedback hidden text-red-400 text-sm mt-1">
      {content.emailRequiredMessage}
    </div>

    <div class="invalid-feedback hidden text-red-400 text-sm mt-1">
      {content.emailInvalidMessage}
    </div>
  </div>

  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder={content.messagePlaceholder}
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none h-36 focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
    ></textarea>

    <div class="empty-feedback hidden invalid-feedback text-red-400 text-sm mt-1">
      {content.messageRequiredMessage}
    </div>
  </div>

  <div class="mt-auto pt-3">
    <Button type="submit" size="lg" block>
      {content.buttonText}
    </Button>

    <div id="result" class="mt-3 text-center"></div>
  </div>
</form>

<style>
  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .was-validated :invalid {
    border-color: #dc3545;

    .was-validated input[type="email"]:placeholder-shown:invalid
  ~ .empty-feedback {
  display: block;
}

.was-validated input[type="email"]:not(:placeholder-shown):invalid
  ~ .invalid-feedback {
  display: block;
}
  }
</style>