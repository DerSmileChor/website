---
import Container from "@components/container.astro";
import { getFormattedDate } from "@utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---
<Layout
  title={frontmatter.title}
  accent="#d92c8a"
>
  <Container>
  <div
  style="background: var(--page-accent, lime); color: white;"
  class="mb-6 rounded p-4 font-bold"
>
  Performance layout test
</div>
 
      <span class="accent-text text-sm font-medium uppercase tracking-wider">
        {frontmatter.category}
      </span>

      <h1
        class="mt-1 text-4xl font-bold lg:text-5xl lg:leading-tight lg:tracking-tight"
      >
        {frontmatter.title}
      </h1>

      <div class="accent-background mt-4 h-1 w-16 rounded-full"></div>

      <div class="mt-4 flex flex-wrap items-center gap-2 md:flex-nowrap">
        <span class="text-gray-500">
          {frontmatter.author}
        </span>

        <span class="text-gray-400">•</span>

        <time class="text-gray-500" datetime={frontmatter.publishDate}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>

        <span class="hidden text-gray-400 md:block">•</span>

        <div class="flex w-full flex-wrap gap-2 md:w-auto">
          {
            frontmatter.tags?.map((tag) => (
              <span class="performance-tag text-sm">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="performance-content prose prose-lg mx-auto mt-8">
      <slot />
    </div>

    <div class="mt-10 text-center">
      <a
        href="/performance"
        class="link-button-outline inline-flex rounded-md px-5 py-3 transition"
      >
        ← Back to Performances
      </a>
    </div>
  </Container>
</Layout>