---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { marked } from "marked";
import { Icon } from "astro-icon/components";

import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

const pages = await getCollection("pages");

const aboutPage = pages.find(
  (entry) => entry.data.pageType === "about",
);

if (!aboutPage || aboutPage.data.pageType !== "about") {
  throw new Error(
    "About page content not found. Expected src/content/pages/about.md",
  );
}

const people = await getCollection(
  "about",
  ({ data }) =>
    !data.draft &&
    data.publishDate < new Date(),
);

people.sort((a, b) => {
  return a.data.order - b.data.order;
});

const leadership = people.filter(
  (person) =>
    person.data.group === "conductor" ||
    person.data.group === "pianists",
);

const generalPictures = people.filter(
  (person) => person.data.group === "general",
);

 
const {
  title,
  accent,
  hero,
  whoWeAre,
  peopleSections,
  coreTeam,
  whereWeHaveBeen,
  whereWeComeFrom,
} = aboutPage.data;

const heroHeadingHtml =
  await marked.parseInline(hero.heading);

const heroDescriptionHtml =
  await marked.parse(hero.description);

const whoWeAreHeadingHtml =
  await marked.parseInline(whoWeAre.heading);

const whoWeAreHtml =
  await marked.parse(whoWeAre.content);

const generalHeadingHtml =
  await marked.parseInline(
    peopleSections.generalHeading,
  );

const leadershipHeadingHtml =
  await marked.parseInline(
    peopleSections.leadershipHeading,
  );

const coreTeamHeadingHtml =
  await marked.parseInline(coreTeam.heading);

const coreTeamDescriptionHtml =
  await marked.parse(coreTeam.description);

const whereWeHaveBeenHeadingHtml =
  await marked.parseInline(
    whereWeHaveBeen.heading,
  );

const whereWeHaveBeenIntroHtml =
  await marked.parse(
    whereWeHaveBeen.introduction,
  );

const whereWeComeFromHeadingHtml =
  await marked.parseInline(
    whereWeComeFrom.heading,
  );

const whereWeComeFromHtml =
  await marked.parse(
    whereWeComeFrom.content,
  );

const initiallyVisibleLocations =
  whereWeHaveBeen.locations.slice(
    0,
    whereWeHaveBeen.initialVisible,
  );

const additionalLocations =
  whereWeHaveBeen.locations.slice(
    whereWeHaveBeen.initialVisible,
  );

const peopleGroups = [
  {
    type: "gallery",
    headingHtml: generalHeadingHtml,
    people: generalPictures,
  },
  {
    type: "people",
    headingHtml: leadershipHeadingHtml,
    people: leadership,
  },
];
---

<main style={`--page-accent: ${accent};`}>
  <Layout title={title} accent={accent}>
    <Container>
      <Sectionhead>
        <Fragment slot="title">
          <span
            class="
              about-inline-markdown
              block text-5xl font-bold
              leading-[1.05] tracking-tight
              lg:text-5xl
            "
            set:html={heroHeadingHtml}
          />
        </Fragment>

        <Fragment slot="desc">
          <div
            class="about-copy"
            set:html={heroDescriptionHtml}
          />
        </Fragment>
      </Sectionhead>

      <!-- Who We Are -->
     <section class="mx-auto mt-16 max-w-4xl md:mt-24">
        <h2
          class="
            about-inline-markdown
            text-3xl font-bold leading-tight
            text-gray-800 md:text-4xl
          "
          set:html={whoWeAreHeadingHtml}
        />

        <div
          class="
            about-copy mt-5
            text-lg leading-[1.75]
            text-slate-500 md:text-xl
          "
          set:html={whoWeAreHtml}
        />
      </section>

      <!-- Conductor and pianists -->
 {
  peopleGroups.map(
    ({ headingHtml, people, type }) =>
      people.length > 0 && (
<section class="mx-auto mt-16 max-w-4xl md:mt-24">
          <h2
            class="
              about-inline-markdown
              text-3xl font-bold
              leading-tight text-gray-800
              md:text-4xl
            "
            set:html={headingHtml}
          />

          {
            type === "gallery" ? (
            <div class="mt-8 grid gap-8 md:grid-cols-3">
                {
                  people.map(
                    (person) =>
                      person.data.image && (
                        <figure class="group">
                         <Picture
                            src={person.data.image}
                            alt={person.data.imageAlt}
                            widths={[400, 600, 900]}
                            sizes="(max-width: 768px) 100vw, 33vw"
                            width={900}
                            height={900}
                            class="
                              aspect-square w-full
                              rounded-xl object-cover
                              transition
                              group-hover:-translate-y-1
                              group-hover:shadow-xl
                            "
                          />
                          {
                            (
                              person.data.name ||
                              person.data.title ||
                              person.data.biography
                            ) && (
                              <figcaption class="mt-3 text-center">
                                {
                                  person.data.name && (
                                    <h3
                                      class="
                                        font-semibold
                                        text-gray-800
                                      "
                                    >
                                      {person.data.name}
                                    </h3>
                                  )
                                }

                                {
                                  person.data.title && (
                                    <p class="mt-1 accent-text">
                                      {person.data.title}
                                    </p>
                                  )
                                }

                                {
                                  person.data.biography && (
                                    <p
                                      class="
                                        mt-2 text-sm
                                        leading-relaxed
                                        text-slate-500
                                      "
                                    >
                                      {person.data.biography}
                                    </p>
                                  )
                                }
                              </figcaption>
                            )
                          }
                        </figure>
                      ),
                  )
                }
              </div>
            ) : (
           <ul
  class="
    mt-8 grid gap-6
    sm:grid-cols-2
    lg:grid-cols-4
  "
>
                {
                  people.map((person) => (
                  <li
  class="
    leadership-card
    min-w-0 rounded-xl
    px-4 py-4
  "
>
                     {
  person.data.image && (
    <Picture
      src={person.data.image}
      alt={person.data.imageAlt}
      widths={[160, 240, 320]}
      sizes="96px"
      width={320}
      height={320}
      class="
        mx-auto mb-4 h-24 w-24
        rounded-full object-cover
      "
    />
  )
}
                       {
  person.data.name && (
<h3 class="text-center text-lg font-semibold leading-tight text-gray-800">
  {person.data.name}
</h3>

<p class="mt-1 text-center text-sm font-medium accent-text">
  {person.data.title}
</p>
  )
}

{
  person.data.biography && (
    <p class="mt-3 leading-relaxed text-slate-500">
      {person.data.biography}
    </p>
  )
}
                    </li>
                  ))
                }
              </ul>
            )
          }
        </section>
      ),
  )
}

      <!-- Core Team -->
      {
        coreTeam.enabled && (
          <section
            class="
              mx-auto mt-16 max-w-4xl
              md:mt-24
            "
          >
            <h2
              class="
                about-inline-markdown
                text-3xl font-bold
                leading-tight text-gray-800
                md:text-4xl
              "
              set:html={coreTeamHeadingHtml}
            />

            {
              coreTeam.description && (
                <div
                  class="
                    about-copy mt-5
                    text-lg leading-[1.75]
                    text-slate-500 md:text-xl
                  "
                  set:html={coreTeamDescriptionHtml}
                />
              )
            }

            {
              coreTeam.image && (
                <Picture
                  src={coreTeam.image.src}
                  alt={coreTeam.image.alt}
                  widths={[600, 900, 1200, 1600]}
                  sizes="(max-width: 900px) 100vw, 900px"
                  width={1600}
                  height={1000}
                  class="
                    mt-8 w-full rounded-xl
                    object-cover
                  "
                />
              )
            }
          </section>
        )
      }

      <!-- Where We’ve Been -->
      <section class="mx-auto mt-16 max-w-4xl md:mt-24">
        <div class="max-w-2xl">
          <h2
            class="
              about-inline-markdown
              text-3xl font-bold
              leading-tight text-gray-800
              md:text-4xl
            "
            set:html={whereWeHaveBeenHeadingHtml}
          />

          <div
            class="
              about-copy mt-5
              text-lg leading-[1.75]
              text-slate-500 md:text-xl
            "
            set:html={whereWeHaveBeenIntroHtml}
          />
        </div>

        <ul class="mt-8 grid gap-x-10 md:grid-cols-2">
          {
            initiallyVisibleLocations.map(
              (location) => (
                <li
                  class="
                    flex items-start gap-3
                    border-b border-slate-200
                    px-2 py-4
                  "
                >
                  <Icon
                    name="bx:bxs-music"
                    class="
                      mt-1 h-5 w-5
                      shrink-0 accent-text
                    "
                  />

                  <span class="leading-relaxed">
                    {location}
                  </span>
                </li>
              ),
            )
          }
        </ul>

        {
          additionalLocations.length > 0 && (
            <details class="mb-16 mt-5 md:mb-24">
              <summary
                class="
                  cursor-pointer font-medium
                  accent-text transition
                  hover:brightness-75
                "
              >
                {whereWeHaveBeen.showMoreText}
              </summary>

              <ul class="mt-4 grid gap-x-10 md:grid-cols-2">
                {
                  additionalLocations.map(
                    (location) => (
                      <li
                        class="
                          flex items-start gap-3
                          border-b border-slate-200
                          px-2 py-4
                        "
                      >
                        <Icon
                          name="bx:bxs-music"
                          class="
                            mt-1 h-5 w-5
                            shrink-0 accent-text
                          "
                        />

                        <span class="leading-relaxed">
                          {location}
                        </span>
                      </li>
                    ),
                  )
                }
              </ul>
            </details>
          )
        }
      </section>

      <!-- Where We Come From -->
      <section class="mx-auto max-w-4xl">
        <h2
          class="
            about-inline-markdown
            text-3xl font-bold
            leading-tight text-gray-800
            md:text-4xl
          "
          set:html={whereWeComeFromHeadingHtml}
        />

        <div
          class="
            about-copy mt-5
            text-lg leading-[1.75]
            text-slate-500 md:text-xl
          "
          set:html={whereWeComeFromHtml}
        />

        {
          whereWeComeFrom.image && (
            <figure
              class="
                group mx-auto mt-12
                w-full max-w-xl md:w-3/4
              "
            >
              <Picture
                src={whereWeComeFrom.image.src}
                alt={whereWeComeFrom.image.alt}
                widths={[600, 900, 1200]}
                sizes="(max-width: 768px) 100vw, 800px"
                width={1200}
                height={1200}
                class="
                  block h-auto w-full
                  rounded-xl bg-white
                  object-cover object-center
                  transition
                  group-hover:-translate-y-1
                  group-hover:shadow-xl
                "
              />

              {
                whereWeComeFrom.image
                  .attribution?.enabled && (
                  <figcaption
                    class="
                      mt-3 text-center text-xs
                      leading-relaxed text-slate-500
                    "
                  >
                    Image by{" "}
                    {
                      whereWeComeFrom.image
                        .attribution.creator
                    }
                    , available from{" "}
                    <a
                      href={
                        whereWeComeFrom.image
                          .attribution.url
                      }
                      target="_blank"
                      rel="noopener noreferrer"
                      class="
                        font-medium accent-text
                        underline underline-offset-2
                        transition hover:brightness-75
                      "
                    >
                      {
                        whereWeComeFrom.image
                          .attribution.source
                      }
                    </a>
                  </figcaption>
                )
              }
            </figure>
          )
        }
      </section>
    </Container>
  </Layout>
</main>

<style>
  .about-inline-markdown :global(strong),
  .about-copy :global(strong) {
    color: var(--page-accent);
    font-weight: inherit;
  }

  .about-copy :global(p + p) {
    margin-top: 1.25rem;
  }

  .about-copy :global(a) {
    color: var(--page-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

 
  .leadership-card {
    border: 1px solid
      color-mix(
        in srgb,
        var(--page-accent) 24%,
        transparent
      );

    background-color: color-mix(
      in srgb,
      var(--page-accent) 5%,
      transparent
    );
  }

  .leadership-card:hover {
    border-color: color-mix(
      in srgb,
      var(--page-accent) 48%,
      transparent
    );

    background-color: color-mix(
      in srgb,
      var(--page-accent) 9%,
      transparent
    );
  }
 
</style>