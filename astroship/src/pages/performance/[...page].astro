---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { marked } from "marked";

import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

export async function getStaticPaths({ paginate }) {
  const performances = await getCollection(
    "performance",
    ({ data }) => !data.draft,
  );

  performances.sort((a, b) => {
    return (
      b.data.publishDate.valueOf() -
      a.data.publishDate.valueOf()
    );
  });

  return paginate(performances, {
    pageSize: 3,
  });
}

const { page } = Astro.props;

const pages = await getCollection("pages");

const performancePage = pages.find(
  (entry) => entry.data.pageType === "performance",
);

if (
  !performancePage ||
  performancePage.data.pageType !== "performance"
) {
  throw new Error(
    "Performance page content not found. Expected src/content/pages/performance.md",
  );
}

const {
  title,
  accent,
  heading,
  description,
} = performancePage.data;

const descriptionHtml = await marked.parse(description);
---

<main style={`--page-accent: ${accent};`}>
  <Layout title={title} accent={accent} description = "Check out Der Smile Chor performances across summer and winter seasons">
  <Container>
    <Sectionhead>
       <Fragment slot="title">
    {heading}
  </Fragment>

  <Fragment slot="desc">
    <div
      class="performance-description"
      set:html={descriptionHtml}
    />
  </Fragment>
    </Sectionhead>

    <main class="mt-16">
<ul
  data-performance-row
  class="
    flex snap-x snap-mandatory gap-6
    overflow-x-auto overscroll-x-contain
    px-[8vw] pb-8 scroll-smooth
    md:px-[12vw]
    lg:px-[18vw]
  "
>
          {
    page.data.map((performance) => {
      const photos = [
        performance.data.image,
        ...(performance.data.gallery ?? []),
      ];

      return (
<li
  data-performance-card
  class="
  w-[78vw] shrink-0 snap-center
    sm:w-[68vw]
    md:w-[58vw]
    lg:w-[50vw]
    xl:w-[44vw]
  "
>
          
        <article
            data-embedded-gallery
            tabindex="0"
           class="performance-card overflow-hidden rounded-2xl border bg-white/70 shadow-sm outline-none transition focus-within:ring-2 focus:ring-2"
            aria-label={`Photo gallery for ${performance.data.title}`}
          >


  <!-- Large slideshow image -->
  <div class="relative bg-black flex-1 p-6">
    {
      photos.map((photo, index) => (
        <figure
          data-slide
          class:list={[
            "relative",
            { hidden: index !== 0 },
          ]}
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            widths={[600, 900, 1200, 1600]}
            sizes="(max-width: 1024px) 100vw, 1024px"
            width={1600}
            height={1000}
            loading={index === 0 ? "eager" : "lazy"}
            class="aspect-[16/10] w-full object-contain"
          />

          {photo.caption && (
            <figcaption class="absolute inset-x-0 bottom-0 bg-black/65 px-4 py-3 text-center text-sm text-white">
              {photo.caption}
            </figcaption>
          )}
        </figure>
      ))
    }

    <!-- Previous and next arrows -->
    {
      photos.length > 1 && (
        <>
          <button
            type="button"
            data-previous-slide
            class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-3xl text-white transition hover:bg-black/85 focus:outline-none focus:ring-2 focus:ring-white"
            aria-label={`Previous photo in ${performance.data.title}`}
          >
            <span aria-hidden="true">‹</span>
          </button>

          <button
            type="button"
            data-next-slide
            class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-3xl text-white transition hover:bg-black/85 focus:outline-none focus:ring-2 focus:ring-white"
            aria-label={`Next photo in ${performance.data.title}`}
          >
            <span aria-hidden="true">›</span>
          </button>

          <div class="absolute right-3 top-3 rounded-full bg-black/65 px-3 py-1 text-sm text-white">
            <span data-current-number>1</span>
            <span aria-hidden="true"> / </span>
            <span>{photos.length}</span>
          </div>
        </>
      )
    }
  </div>

  <!-- Performance title and information -->
<header class="performance-divider border-b bg-zinc-50 p-6 sm:p-8">
   <p class="accent-text text-sm font-medium uppercase tracking-wide">
      {performance.data.category}
    </p>

    <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-800">
      {performance.data.title}
    </h2>

    <p class="mt-3 text-sm text-slate-500">
      {performance.data.author}

      <span class="mx-2" aria-hidden="true">
        ·
      </span>

      <time datetime={performance.data.publishDate.toISOString()}>
        {
          performance.data.publishDate.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "long",
            year: "numeric",
          })
        }
      </time>
    </p>

    {performance.data.snippet && (
      <p class="mt-5 max-w-3xl leading-7 text-slate-600">
        {performance.data.snippet}
      </p>
    )}
  </header>
  <!-- Thumbnail strip -->
  {
    photos.length > 1 && (
    <div class="performance-thumbnail-area px-4 py-4">
        <div
          class="flex gap-3 overflow-x-auto pb-1"
          aria-label={`Choose a photo from ${performance.data.title}`}
        >
          {photos.map((photo, index) => (
            <button
              type="button"
              data-thumbnail
              data-slide-number={index}
            class:list={[
  `
    performance-thumbnail
    gallery-thumbnail
    shrink-0 rounded-lg
    border-2 border-transparent
    opacity-60 transition
    hover:opacity-100
    focus:outline-none
  `,
  {
    "is-active opacity-100": index === 0,
  },
]}
              aria-label={`Show photo ${index + 1} of ${photos.length}`}
              aria-current={index === 0 ? "true" : "false"}
            >
              <Picture
                src={photo.src}
                alt=""
                width={160}
                height={100}
                loading="lazy"
                class="h-20 w-28 rounded-lg object-cover sm:h-24 sm:w-36"
              />
            </button>
          ))}
        </div>
      </div>
    )
  }
</article>
              </li>
            );
          })
        }
      </ul>

      <!-- Pagination -->
      {
        page.lastPage > 1 && (
         <nav class=" performance-divider mx-auto mt-20 grid max-w-5xl grid-cols-3 items-center gap-3 border-t pt-8" aria-label="Performance archive pages">
            <div>
              {page.url.prev && (
              <a
              href={page.url.prev}
              class="
                performance-nav
                inline-flex items-center rounded-lg
                border px-4 py-2 font-medium
                accent-text transition
                focus:outline-none focus:ring-2
              "
            >
                  <span aria-hidden="true">←</span>
                  <span class="ml-2 hidden sm:inline">
                    Newer performances
                  </span>
                  <span class="ml-2 sm:hidden">Newer</span>
                </a>
              )}
            </div>

            <p class="text-center text-sm text-slate-500">
              Page {page.currentPage} of {page.lastPage}
            </p>

            <div class="text-right">
              {page.url.next && (
                <a
                  href={page.url.next}
                  class="
    performance-nav
    inline-flex items-center rounded-lg
    border px-4 py-2 font-medium
    transition focus:outline-none
  "
                >
                  <span class="mr-2 hidden sm:inline accent-text" >
                    Older performances
                  </span>
                  <span class="mr-2 sm:hidden accent-text">Older</span>
                  <span aria-hidden="true" class ="accent-text">→</span>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </main>
  </Container>
</Layout>
</main>
<style is:global>
  body {
    background: white;
  }
</style>

<script>
  /*
   * Initialise every slideshow rendered on the current page.
   * Each gallery maintains its own active slide.
   */
  document
    .querySelectorAll<HTMLElement>("[data-embedded-gallery]")
    .forEach((gallery) => {
      const slides =
        gallery.querySelectorAll<HTMLElement>("[data-slide]");

      const thumbnails =
        gallery.querySelectorAll<HTMLButtonElement>(
          "[data-thumbnail]",
        );

      const previousButton =
        gallery.querySelector<HTMLButtonElement>(
          "[data-previous-slide]",
        );

      const nextButton =
        gallery.querySelector<HTMLButtonElement>(
          "[data-next-slide]",
        );

      const currentNumber =
        gallery.querySelector<HTMLElement>(
          "[data-current-number]",
        );

      let currentIndex = 0;

      function showSlide(
        index: number,
        scrollThumbnail = false,
      ) {
        if (slides.length === 0) return;

        /*
         * Wrap from the last image to the first and vice versa.
         */
        currentIndex =
          (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === currentIndex;

          slide.classList.toggle("hidden", !isActive);
        });

        thumbnails.forEach(
          (thumbnail, thumbnailIndex) => {
            const isActive =
              thumbnailIndex === currentIndex;

            thumbnail.classList.toggle(
              "opacity-60",
              !isActive,
            );

            thumbnail.classList.toggle(
              "opacity-100",
              isActive,
            );


            thumbnail.classList.toggle(
              "is-active",
              isActive,
            );

            thumbnail.setAttribute(
              "aria-current",
              isActive ? "true" : "false",
            );

            /*
             * Keep the selected thumbnail visible when
             * the thumbnail strip is horizontally scrollable.
             */
                 if (isActive && scrollThumbnail) {
            thumbnail.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "nearest",
            });
          }
          },
        );

        if (currentNumber) {
          currentNumber.textContent = String(
            currentIndex + 1,
          );
        }
      }

     previousButton?.addEventListener("click", () => {
      showSlide(currentIndex - 1, true);
    });

    nextButton?.addEventListener("click", () => {
      showSlide(currentIndex + 1, true);
    });

      thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => {
      const requestedIndex = Number(
        thumbnail.dataset.slideNumber,
      );

      if (Number.isNaN(requestedIndex)) return;

      showSlide(requestedIndex, true);
    });
      });

      /*
       * Arrow-key navigation works when the performance
       * gallery or one of its controls has focus.
       */
      gallery.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showSlide(currentIndex - 1, true);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          showSlide(currentIndex + 1, true);
        }
      });

      showSlide(0);
    });

  const performanceRow =
  document.querySelector<HTMLElement>(
    "[data-performance-row]",
  );

const performanceCards =
  document.querySelectorAll<HTMLElement>(
    "[data-performance-card]",
  );

if (performanceRow) {
requestAnimationFrame(() => {
  performanceRow.scrollLeft = 0;
});
performanceCards.forEach((card) => {
  card.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    // Do not hijack clicks on slideshow controls, links, or thumbnails.
    if (
      target.closest(
        "button, a, iframe, [data-thumbnail], [data-previous-slide], [data-next-slide]",
      )
    ) {
      return;
    }

    card.scrollIntoView({
      behavior: "smooth",
      block: "nearest",
      inline: "center",
    });
  });
});
  const performanceObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const card = entry.target as HTMLElement;

        /*
         * A lower threshold works better because neighboring cards
         * are deliberately visible at the edges.
         */
        const isMainCard =
          entry.isIntersecting &&
          entry.intersectionRatio >= 0.55;

        card.classList.toggle(
          "scale-[0.97]",
          !isMainCard,
        );

        card.classList.toggle(
          "scale-100",
          isMainCard,
        );
      });
    },
    {
      root: performanceRow,
      threshold: [0.55],
    },
  );

  performanceCards.forEach((card) => {
    performanceObserver.observe(card);
  });
}
</script>

<style>
  .performance-description :global(strong) {
    color: var(--page-accent);
    font-weight: inherit;
  }

  .performance-description :global(p + p) {
    margin-top: 0.5rem;
  }

  .performance-description :global(a) {
    color: var(--page-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

    .performance-card {
    border: 1px solid
      color-mix(in srgb, var(--page-accent) 18%, white);
  }

  .performance-card:focus,
  .performance-card:focus-within {
    --tw-ring-color: var(--page-accent);
  }

    .performance-nav {
    border-color: color-mix(
      in srgb,
      var(--page-accent) 28%,
      transparent
    );
  }

  .performance-nav:hover {
    background-color: color-mix(
      in srgb,
      var(--page-accent) 12%,
      transparent
    );
  }

  .performance-nav:focus-visible {
    --tw-ring-color: var(--page-accent);
  }

    .performance-divider {
    border-color: color-mix(
      in srgb,
      var(--page-accent) 18%,
      transparent
    );
  }

  .gallery-thumbnail {
    border-style: solid;
    border-color: transparent;
  }

  .gallery-thumbnail.is-active {
    border-color: var(--page-accent);
    box-shadow:
      0 0 0 2px
      color-mix(
        in srgb,
        var(--page-accent) 20%,
        transparent
      );
  }

  .gallery-thumbnail:hover:not(.is-active) {
    border-color: color-mix(
      in srgb,
      var(--page-accent) 45%,
      transparent
    );
  }

  .gallery-thumbnail:focus-visible {
    outline: 3px solid var(--page-accent);
    outline-offset: 2px;
  }
  }

  .gallery-thumbnail:focus-visible {
    outline: 3px solid var(--page-accent);
    outline-offset: 2px;
  }

  .performance-nav {
    color: var(--page-accent);
    border-color: color-mix(
      in srgb,
      var(--page-accent) 30%,
      transparent
    );
  }

  .performance-nav:hover {
    background-color: color-mix(
      in srgb,
      var(--page-accent) 12%,
      transparent
    );
  }

  .performance-nav:focus-visible {
    outline: 3px solid var(--page-accent);
    outline-offset: 3px;
  }
</style>

 