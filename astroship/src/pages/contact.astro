---
import Contactform from "@components/contactform.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">We'd love to connect with you!</Fragment>
    </Sectionhead>
 
<div
  class="
    mx-auto mt-16 grid max-w-4xl items-stretch gap-10
    lg:grid-cols-[320px_420px_320px]
  "
>
  <!-- Column 1 -->
  <div class="h-full">
    <h2 class="text-2xl font-medium text-gray-800">
      Contact Der Smile Chor
    </h2>

    <p class="mt-3 text-lg leading-relaxed text-slate-500">
      Interested in joining?
      <br />
      Interested in having us come sing? Have other questions?
      <br />
      Fill out the form or send us an email.
    </p>

    <div class="mt-5">
      <div class="mt-2 flex items-center space-x-2 text-gray-600">
        <Icon
          class="h-4 w-4 text-gray-400"
          name="uil:envelope"
        />

        <a href="mailto:dersmilechor@gmail.com">
          dersmilechor@gmail.com
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-semibold">
        Follow the choir
      </h2>

      <div class="mt-5 flex flex-wrap gap-4">
        <a
          href="https://www.instagram.com/dersmilechor/"
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex items-center gap-2 rounded-md
            border border-slate-300 px-5 py-3 font-medium
            transition hover:bg-slate-50
          "
        >
          <Icon name="bx:bxl-instagram" class="h-5 w-5" />
          Instagram
        </a>

        <a
          href="https://www.facebook.com/share/16JrA3sF4V/"
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex items-center gap-2 rounded-md
            border border-slate-300 px-5 py-3 font-medium
            transition hover:bg-slate-50
          "
        >
          <Icon name="bx:bxl-facebook-circle" class="h-5 w-5" />
          Facebook
        </a>
      </div>
    </div>
  </div>

  <!-- Column 2 -->
  <div class="h-full">
 
    <Contactform />
    
  </div>

  <!-- Column 3 -->
  <div
    class="
      flex h-full flex-col overflow-hidden
      rounded-lg border border-slate-200
    "
  >
    <p class="px-4 py-4 text-center text-sm text-slate-600">
      We rehearse every Tuesday evening at the
      <br />
      <strong>EinweltHaus</strong>
      <br />
      Schwanthalerstraße 80
      <br />
      80336 Munich
    </p>

    <img
      src="/images/einwelthaus.png"
      alt="Map showing the rehearsal location"
      class="min-h-0 w-full flex-1 object-cover"
    />

    <div class="p-4">
      <a
        href="https://maps.app.goo.gl/ps78sSpPPjc72vk1A"
        target="_blank"
        rel="noopener noreferrer"
        class="
          flex w-full justify-center rounded
          bg-blue-600 px-4 py-2 text-white
          transition hover:bg-blue-700
        "
      >
        Open in Google Maps
      </a>
    </div>
  </div>
</div>
  </Container>
</Layout>


