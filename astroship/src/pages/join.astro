---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/join.astro";

const join = [

  {
    name: "Experienced",
    join: {
      monthly: "Conductors",
      annual: "$16",
      discount: "10%",
      original: "$24",
    },
    popular: true,
    features: [
      "Experience with working with choirs or musicians",
    ],
    button: {
      text: "Contact Us",
      link: "#",
    },
  },
    {
    name: "Everbody",
    join: "Singers",
    popular: true,
    features: [
      "Altos",
      "Sopranos",
      "Basses",
      "All experience levels welcome",
    ],
    button: {
      text: "Contact Us",
      link: "/",
    },
  },
  {
    name: "Experienced",
    join: "Pianists",
    popular: false,
    features: [
      "Accompanists"
    ],
    button: {
      text: "Contact us",
      link: "/contact",
    },
  },
];
---

<Layout title="Join">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Join Us!</Fragment>
      <Fragment slot="desc">
        
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-screen-lg mt-12">
      {join.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
