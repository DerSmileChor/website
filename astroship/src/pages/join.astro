---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/join.astro";
import CodeOfConductCTA from "@components/code-of-conduct-cta.astro";

const join = [

  {
    name: "Experienced",
    join: {
      monthly: "Conductors",
      annual: "$16",
      discount: "10%",
      original: "$24",
    },
    popular: false,
      lookingFor: [
      "Experience working with choirs or musicians",
      "Confidence leading group rehearsals",
      "A supportive and collaborative approach",
    ],

    expectations: [
      "Lead 2-hour weekly rehearsals during the season",
      "Help select and prepare suitable repertoire",
      "Support approximately 5–8 performances per season",
    ],
    button: {
      text: "Contact Us",
      link: "/contact",
    },
  },
    {
    name: "All",
    join: "Singers",
    popular: true,
   lookingFor: [
      "Altos, sopranos, tenors, and basses",
      "All experience levels are welcome",
      "A love of singing and making music with others",
      "No formal musical background is required",
    ],

    expectations: [
      "Attend 2-hour weekly rehearsals",
      "Commit to approximately 10 rehearsal weeks per season",
      "Take part in around 5–8 performances (around 2 hours each)",
      "Practise songs independently when needed",
    ],

    button: {
      text: "Contact Us",
      link: "/contact",
    },
  },
  {
    name: "Experienced",
    join: "Pianists",
    popular: false,
   lookingFor: [
      "Pianists comfortable accompanying a choir",
      "Strong sight-reading and rehearsal skills",
      "A flexible and supportive musical approach",
    ],

    expectations: [
      "Attend 2-hour regular rehearsals",
      "Accompany performances during the season (around 2 hours each)",
      "Coordinate with the conductor on repertoire and arrangements",
    ],

    button: {
      text: "Contact us",
      link: "/contact",
    },
  },
];
---
<main style="--page-accent: var(--accent-join);">
<Layout title="Join"
 accent="var(--accent-join)">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Come make <span class = "accent-text">music </span> with us!</Fragment>
      <Fragment slot="desc">
       <div
  class="
    mx-auto mt-6 max-w-3xl
    rounded-xl border border-blue-100
     px-6 py-6
    shadow-sm
    md:px-8
  "
>
  <p class="mb-3 text-center text-sm font-semibold uppercase tracking-wide accent-text">
    How our seasons work
  </p>

  <p class="text-center leading-7 text-slate-700">
    We perform two seasons each year, each consisting of around <br>
    <strong><span class = "accent-text">10 rehearsals</span></strong> and <strong><span class = "accent-text">5–8 performances</span></strong>.
  </p>

  <p class="mt-3 text-center leading-7 text-slate-700">
    Our winter season runs from <strong><span class = "accent-text">October to December</span></strong> with holiday repertoire,
    while our summer season runs from <strong><span class = "accent-text">April to June</span></strong> with popular music.
  </p>

  <p class="mt-3 text-center font-medium leading-7 text-slate-800">
    New participants <span class = "accent-text">join at the beginning of each season</span>, as the short
    rehearsal period makes <span class = "accent-text">mid-season entry difficult.</span>
  </p>
</div>
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-screen-lg mt-12">
      {join.map((item) => <PricingCard plan={item} />)}
    </div>
      <CodeOfConductCTA />
  </Container>

</Layout>
</main>
