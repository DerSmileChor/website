---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/join.astro";
import CodeOfConductCTA from "@components/code-of-conduct-cta.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";


const pages = await getCollection("pages");
 
const joinPage = pages.find(
  (entry) => entry.data.pageType === "join",
);


if (!joinPage || joinPage.data.pageType !== "join") {
  throw new Error(
    "Join page content not found. Expected src/content/pages/join.md",
  );
}

const {
  title,
  heading,
  seasonInfo,
  roles,
  codeOfConduct,
  accent
} = joinPage.data;

const headingHtml = await marked.parseInline(heading);
const seasonHtml = await marked.parse(seasonInfo.content);

---
<main style={`--page-accent: ${accent};`}>
  <Layout title={title} accent={accent}
   description="Find out how to join Der Smile Chor, including how our seasons work and what to expect.">
    <Container>
      <Sectionhead>
    <Fragment slot="title">
      <span class="join-heading" set:html={headingHtml} />
    </Fragment>

        <Fragment slot="desc">
                  <div
          class="
            mx-auto mt-6 max-w-3xl rounded-xl
            border border-blue-100 px-6 py-6
            shadow-sm md:px-8
          "
        >
          <p
            class="
              mb-3 text-center text-sm font-semibold
              uppercase tracking-wide accent-text
            "
          >
            {seasonInfo.label}
          </p>

          <div
            class="season-copy text-center leading-7 text-slate-700"
            set:html={seasonHtml}
          />
        </div>
        </Fragment>
      </Sectionhead>

      <div
        class="
          mx-auto mt-12 grid max-w-screen-lg
          gap-10 md:grid-cols-3
        "
      >
        {
          roles.map((role) => (
            <PricingCard
              plan={{
                name: role.experience,
                join: role.role,
                popular: role.featured,
                lookingFor: role.lookingFor,
                expectations: role.expectations,
                button: role.button,
              }}
            />
          ))
        }
      </div>

      <CodeOfConductCTA {...codeOfConduct} />
    </Container>
  </Layout>
</main>

<style>
  .join-heading :global(strong) {
    color: var(--page-accent);
    font-weight: inherit;
  }

  .season-copy :global(p + p) {
    margin-top: 0.75rem;
  }

  .season-copy :global(strong) {
    color: var(--page-accent);
    font-weight: 700;
  }

  .season-copy :global(a) {
    color: var(--page-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .season-copy :global(ul) {
    margin-top: 0.75rem;
    list-style: disc;
    padding-left: 1.5rem;
    text-align: left;
  }
</style>